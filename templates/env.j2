TZ={{ haben_environment_variables_tz }}

DATABASE_URL={{ haben_database_url }}
{% if haben_database_migration_url %}
MIGRATION_DATABASE_URL={{ haben_database_migration_url }}
{% endif %}

BETTER_AUTH_URL={{ haben_base_url }}
BETTER_AUTH_SECRET={{ haben_environment_variables_better_auth_secret }}
HABEN_ENCRYPTION_KEY={{ haben_environment_variables_haben_encryption_key }}
{% if haben_environment_variables_haben_setup_code %}
HABEN_SETUP_CODE={{ haben_environment_variables_haben_setup_code }}
{% endif %}

OIDC_ONLY={{ haben_environment_variables_oidc_only | bool | to_json }}
{% if haben_environment_variables_oidc_only | bool %}
OIDC_ISSUER={{ haben_environment_variables_oidc_issuer }}
OIDC_CLIENT_ID={{ haben_environment_variables_oidc_client_id }}
OIDC_CLIENT_SECRET={{ haben_environment_variables_oidc_client_secret }}
{% if haben_environment_variables_oidc_scopes %}
OIDC_SCOPES={{ haben_environment_variables_oidc_scopes }}
{% endif %}
{% if haben_environment_variables_oidc_display_name %}
OIDC_DISPLAY_NAME={{ haben_environment_variables_oidc_display_name }}
{% endif %}
OIDC_GROUPS_CLAIM={{ haben_environment_variables_oidc_groups_claim }}
OIDC_GROUP_INHABER={{ haben_environment_variables_oidc_group_inhaber }}
OIDC_GROUP_STEUERBERATUNG={{ haben_environment_variables_oidc_group_steuerberatung }}
{% endif %}

{% if haben_environment_variables_eric_auto_install_enabled | bool %}
ERIC_AUTO_INSTALL=ja
{% endif %}
{% if haben_environment_variables_elster_hersteller_id %}
ELSTER_HERSTELLER_ID={{ haben_environment_variables_elster_hersteller_id }}
{% endif %}

{{ haben_environment_variables_additional_variables }}
